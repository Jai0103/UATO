    }
    match /inventoryMaintenance/{maintenanceId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryMediaReferences/{referenceId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalRecords/{approvalId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalLocations/{locationId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalDocuments/{documentId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /fatigueRiskQuestions/{questionId} {
      allow read: if hasModule("fatigueRisk");
      allow create, update, delete: if isAdmin();
    }
    match /fatigueRiskRecords/{recordId} {
      allow read, create, update, delete: if hasModule("fatigueRisk");
    }
    match /fatigueRiskResponses/{responseId} {
      allow read, create, update, delete: if hasModule("fatigueRisk");
    }
    match /fatigueRiskSignatures/{recordId} {
      allow read, create, update, delete: if hasModule("fatigueRisk");
    }
    match /auditEvents/{auditId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isValidFlightLogAuditEvent(auditId) || isValidOperationalAuditEvent(auditId);
    }
    match /auditEventDetails/{auditId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isValidFlightLogAuditDetail(auditId) || isValidOperationalAuditDetail(auditId);
    }
    match /staffTrainingDescriptions/{itemId} {
      allow read: if hasModule("staffTraining");
      allow create, update, delete: if isAdmin();
    }
    match /staffTrainingRecords/{recordId} {
      allow read, create, update, delete: if hasModule("staffTraining");
    }
    match /staffTrainingEntries/{entryId} {
      allow read, create, update, delete: if hasModule("staffTraining");
    }
    match /staffTrainingSignatures/{recordId} {
      allow read, create, update, delete: if hasModule("staffTraining");
    }
    match /staffTrainingTombstones/{recordId} {
      allow read, create, update, delete: if hasModule("staffTraining");
    }
    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /attendancePublicSessions/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /attendanceSubmissions/{submissionId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
    match /evaluationTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationQuestions/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationSessions/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationPublicSessions/{token} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationResponseKeys/{keyId} {
      allow read, write: if false;
    }
    match /evaluationSessionQuestions/{questionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationResponses/{responseId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /evaluationAnswers/{answerId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /migrationRuns/{runId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
