
    match /flightEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogIdentifiers/{identifierId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogMasterData/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceMasterData/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingDescriptions/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /migrationRuns/{runId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
