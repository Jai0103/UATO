rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function ownsAvatar(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    match /user-avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsAvatar(userId)
        && fileName == "avatar.webp"
        && request.resource.size < 500 * 1024
        && request.resource.contentType == "image/webp";
      allow delete: if ownsAvatar(userId) && fileName == "avatar.webp";
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
