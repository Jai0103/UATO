rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveUser() {
      return signedIn()
        && currentUser().data.status == "active";
    }
    function isAdmin() {
      return isActiveUser()
        && currentUser().data.role == "admin";
    }
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
    // Migration collections are admin-only until trainer permissions are enabled.
    match /flightLogRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogIdentifiers/{identifierId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /flightLogMasterData/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceMasterData/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /uaMaintenanceSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryMasterData/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryAssets/{assetId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryTransactions/{transactionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryMaintenance/{maintenanceId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventoryMediaReferences/{referenceId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalRecords/{approvalId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalLocations/{locationId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /approvalDocuments/{documentId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingDescriptions/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /migrationRuns/{runId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
