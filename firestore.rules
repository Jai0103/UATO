        && request.resource.data.schemaVersion == 2
        && request.resource.data.updatedValue.keys().hasOnly([
          "sessionId",
          "period",
          "learnerName",
          "lastFour"
        ])
        && request.resource.data.details.keys().hasOnly([
          "courseName",
          "courseDate",
          "instructorName",
          "period"
        ])
        && request.resource.data.updatedValue.sessionId is string
        && request.resource.data.updatedValue.period in ["am", "pm"]
        && request.resource.data.updatedValue.learnerName is string
        && request.resource.data.updatedValue.lastFour.matches("^[A-Z0-9]{4}$")
        && existsAfter(/databases/$(database)/documents/auditEvents/$(auditId))
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.action == "ATTENDANCE_CHECKED_IN"
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.entityType == "attendance"
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.entityId == request.resource.data.entityId
        && getAfter(/databases/$(database)/documents/attendanceSubmissions/$(request.resource.data.entityId)).data.sessionId == request.resource.data.updatedValue.sessionId
        && getAfter(/databases/$(database)/documents/attendanceSubmissions/$(request.resource.data.entityId)).data.period == request.resource.data.updatedValue.period
        && getAfter(/databases/$(database)/documents/attendanceSubmissions/$(request.resource.data.entityId)).data.learnerName == request.resource.data.updatedValue.learnerName
        && getAfter(/databases/$(database)/documents/attendanceSubmissions/$(request.resource.data.entityId)).data.lastFour == request.resource.data.updatedValue.lastFour
      );
    }
    match /staffTrainingDescriptions/{itemId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingRecords/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingEntries/{entryId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingSignatures/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staffTrainingTombstones/{recordId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /attendanceSessions/{sessionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /attendancePublicSessions/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /attendanceSubmissions/{submissionId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          "id",
          "sessionId",
          "publicToken",
          "period",
          "learnerName",
          "learnerNameLower",
          "lastFour",
          "identityHash",
          "signatureDataUrl",
          "submittedAt",
          "updatedAt"
        ])
        && request.resource.data.id == submissionId
        && request.resource.data.period in ["am", "pm"]
        && request.resource.data.learnerName is string
        && request.resource.data.learnerName.size() >= 2
        && request.resource.data.learnerName.size() <= 100
        && request.resource.data.learnerNameLower is string
        && request.resource.data.lastFour is string
        && request.resource.data.lastFour.matches("^[A-Z0-9]{4}$")
        && request.resource.data.identityHash is string
        && request.resource.data.identityHash.matches("^[a-f0-9]{64}$")
        && request.resource.data.signatureDataUrl is string
        && request.resource.data.signatureDataUrl.matches("^data:image/png;base64,.*")
        && request.resource.data.signatureDataUrl.size() <= 350000
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && publicAttendanceSession(request.resource.data.publicToken).data.sessionId == request.resource.data.sessionId
        && publicAttendanceSession(request.resource.data.publicToken).data.status == "open"
        && (
          (request.resource.data.period == "am"
            && publicAttendanceSession(request.resource.data.publicToken).data.amOpen == true)
          ||
          (request.resource.data.period == "pm"
            && publicAttendanceSession(request.resource.data.publicToken).data.pmOpen == true)
        );
    }
    match /migrationRuns/{runId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
