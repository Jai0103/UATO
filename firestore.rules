rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveUser() {
      return signedIn()
        && currentUser().data.status == "active";
    }
    function isAdmin() {
      return isActiveUser()
        && currentUser().data.role == "admin";
    }
    function isFlightLogAuditAction(action) {
      return action in [
        "FLIGHT_CREATED",
        "FLIGHT_UPDATED",
        "FLIGHT_DELETED"
      ];
    }
    function isValidFlightLogAuditEvent(auditId) {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          "id",
          "timestamp",
          "actorUserId",
          "actorName",
          "actorNameLower",
          "actorEmail",
          "actorRole",
          "action",
          "entityType",
          "entityId",
          "entityName",
          "entityNameLower",
          "detailsAvailable",
          "source",
          "schemaVersion"
        ])
        && request.resource.data.id == auditId
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.actorName == currentUser().data.name
        && request.resource.data.actorEmail == currentUser().data.email
        && request.resource.data.actorRole == currentUser().data.role
        && isFlightLogAuditAction(request.resource.data.action)
        && request.resource.data.entityType == "flightLog"
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityName is string
        && request.resource.data.entityName.size() > 0
        && request.resource.data.entityName.size() <= 200
        && request.resource.data.timestamp is string
        && request.resource.data.detailsAvailable == true
        && request.resource.data.source == "firebase-live"
        && request.resource.data.schemaVersion == 2;
    }
    function isValidFlightLogAuditDetail(auditId) {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          "auditId",
          "entityId",
          "previousValue",
          "updatedValue",
          "details",
          "source",
          "schemaVersion"
        ])
        && request.resource.data.auditId == auditId
        && request.resource.data.source == "firebase-live"
        && request.resource.data.schemaVersion == 2
        && existsAfter(/databases/$(database)/documents/auditEvents/$(auditId))
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.actorUserId == request.auth.uid
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.entityType == "flightLog"
        && isFlightLogAuditAction(getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.action)
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.entityId == request.resource.data.entityId;
    }
    function publicAttendanceSession(token) {
      return get(/databases/$(database)/documents/attendancePublicSessions/$(token));
    }
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      // Account administration is performed only by trusted Cloud Functions.
