rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveUser() {
      return signedIn()
        && currentUser().data.status == "active";
    }
    function isAdmin() {
      return isActiveUser()
        && currentUser().data.role == "admin";
    }
    function hasModule(permission) {
      return isAdmin() || (
        isActiveUser()
        && currentUser().data.role == "trainer"
        && (
          (
            currentUser().data.keys().hasAny(["permissions"])
            && currentUser().data.permissions is list
            && currentUser().data.permissions.hasAny([permission])
          )
          || (
            !currentUser().data.keys().hasAny(["permissions"])
            && permission in ["flightLogs", "attendance", "evaluations", "reports"]
          )
        )
      );
    }
    function isOperationalAuditAction(action) {
      return (hasModule("staffTraining") && action in ["STAFF_TRAINING_CREATED", "STAFF_TRAINING_UPDATED", "STAFF_TRAINING_DELETED"])
        || (hasModule("uaMaintenance") && action in ["UA_MAINTENANCE_CREATED", "UA_MAINTENANCE_UPDATED", "UA_MAINTENANCE_DELETED"])
        || (hasModule("fatigueRisk") && action in ["FATIGUE_RISK_CREATED", "FATIGUE_RISK_UPDATED", "FATIGUE_RISK_DELETED"]);
    }
    function isValidOperationalAuditEvent(auditId) {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          "id", "timestamp", "actorUserId", "actorName", "actorNameLower",
          "actorEmail", "actorRole", "action", "entityType", "entityId",
          "entityName", "entityNameLower", "detailsAvailable", "source", "schemaVersion"
        ])
        && request.resource.data.id == auditId
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.actorName == currentUser().data.name
        && request.resource.data.actorEmail == currentUser().data.email
        && request.resource.data.actorRole == currentUser().data.role
        && isOperationalAuditAction(request.resource.data.action)
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityName is string
        && request.resource.data.detailsAvailable == true
        && request.resource.data.source == "firebase-live"
        && request.resource.data.schemaVersion == 2;
    }
    function isValidOperationalAuditDetail(auditId) {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          "auditId", "entityId", "previousValue", "updatedValue", "details", "source", "schemaVersion"
        ])
        && request.resource.data.auditId == auditId
        && request.resource.data.source == "firebase-live"
        && request.resource.data.schemaVersion == 2
        && existsAfter(/databases/$(database)/documents/auditEvents/$(auditId))
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.actorUserId == request.auth.uid
        && isOperationalAuditAction(getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.action)
        && getAfter(/databases/$(database)/documents/auditEvents/$(auditId)).data.entityId == request.resource.data.entityId;
    }
    function isFlightLogAuditAction(action) {
      return action in [
        "FLIGHT_CREATED",
        "FLIGHT_UPDATED",
        "FLIGHT_DELETED"
      ];
    }
    function isValidFlightLogAuditEvent(auditId) {
      return isActiveUser()
        && request.resource.data.keys().hasOnly([
          "id",
          "timestamp",
          "actorUserId",
          "actorName",
